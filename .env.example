# ─── Site ────────────────────────────────────────────────────────────────
# Public URL used for SEO metadata, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in

# ─── Payments (Razorpay) ─────────────────────────────────────────────────
# Test mode keys start with rzp_test_, live keys with rzp_live_.
# Dashboard → Account & Settings → API Keys  (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Same value as RAZORPAY_KEY_ID. The key id is safe to expose; the secret is NOT.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Optional: force a provider. "razorpay" | "mock" | "stripe"
# Default: razorpay when keys are present; a "mock" demo checkout in
# development when they are not. Production never falls back to mock.
# PAYMENT_PROVIDER=razorpay

# Optional: allow the product render studio (/studio) in production builds.
# ENABLE_STUDIO=true
