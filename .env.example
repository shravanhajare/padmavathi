# ─── Site ────────────────────────────────────────────────────────────────
# Public URL used for SEO metadata, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in

# ─── Database (Supabase Postgres) ────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Server-only: this carries the database password. Create the tables once with `npm run db:setup`.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Publishable key: safe in the browser (the app's tables live in a private schema with RLS on).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ─── Sessions ────────────────────────────────────────────────────────────
# Signs the session cookie (a JWT — see lib/jwt.ts). Required in production: the
# app refuses to start a session without it. Generate with `openssl rand -base64 32`
# and never reuse it across environments; rotating it logs every device out.
SESSION_SECRET=

# ─── Orders on WhatsApp ──────────────────────────────────────────────────
# Number that receives every order: country code + number, no "+" or spaces.
WHATSAPP_ORDER_NUMBER=919590077817

# Optional: send each order to that number automatically, with no tap from the customer.
# Option A, WhatsApp Cloud API (Meta Business): a permanent token and the sender phone-number id.
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_ID=
# Option B, CallMeBot (free, personal): message +34 644 51 95 23 "I allow callmebot to send me messages"
# from the order number, and paste the API key it replies with.
# CALLMEBOT_APIKEY=

# Optional: allow the product render studio (/studio) in production builds.
# ENABLE_STUDIO=true
